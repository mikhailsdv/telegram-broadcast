{
	"name": "telegram-broadcast",
	"version": "0.0.3",
	"type": "module",
	"description": "A powerful TypeScript-based low-code project for sending mass broadcasts with support for A/B testing, media caching, and advanced formatting",
	"scripts": {
		"raw": "tsx ./src/raw.ts",
		"poll": "tsx ./src/poll.ts",
		"cache": "tsx ./src/cacheMedia.ts",
		"get-file": "tsx ./src/getFile.ts",
		"broadcast": "tsx ./src/startBroadcast.ts",
		"format": "prettier --write ."
	},
	"author": "@mikhailsdv",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mikhailsdv/telegram-broadcast/issues"
	},
	"homepage": "https://github.com/mikhailsdv/telegram-broadcast#readme",
	"dependencies": {
		"abort-controller": "^3.0.0",
		"cac": "^7.0.0",
		"dotenv": "^16.4.7",
		"grammy": "^1.44.0",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.3",
		"tsc": "^2.0.4",
		"tsx": "^4.23.0",
		"typescript": "^5.7.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"prettier": "^3.8.1"
	}
}